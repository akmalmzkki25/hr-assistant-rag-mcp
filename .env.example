# Ambil key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-2

# Typesense lokal (lihat README untuk perintah docker)
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=

# Postgres lokal; database hr_assistant dibuat oleh: python -m hr_assistant db-init
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/hr_assistant
